{
  "name": "@ciphera-net/pulse-astro",
  "version": "1.0.1",
  "description": "Add Pulse Analytics \u2014 privacy-first web analytics \u2014 to an Astro site with one integration. No cookies, no personal data, under 3 KB.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://pulse.ciphera.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciphera-net/pulse-astro.git"
  },
  "bugs": "https://github.com/ciphera-net/pulse-astro/issues",
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "analytics",
    "privacy",
    "pulse",
    "gdpr"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "astro": "^7.3.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
